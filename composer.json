{
    "name": "dmytrof/import-fractal-bundle",
    "type": "symfony-bundle",
    "description": "Symfony ImportFractalBundle to implement Fractal by League for DmytrofImportBundle",
    "keywords": ["Import"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dmytro Feshchenko",
            "email": "dmytro.feshchenko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "dmytrof/fractal-bundle": "^1.4",
        "dmytrof/import-bundle": "^1.24",
        "dmytrof/models-management-fractal-bundle": "^1.4",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Dmytrof\\ImportFractalBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmytrof\\ImportFractalBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
